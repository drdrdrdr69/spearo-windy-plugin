{
    "name": "windy-plugin-spearo",
    "version": "0.1.6",
    "description": "Windy.com plugin: water visibility, wave/wind safety verdict and no-take zones by spearo.app",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && mkdir dist && SERVE=false rollup -c && cp package.json dist/",
        "build:win": "rmdir /s /q dist && mkdir dist && set SERVE=false && rollup -c && copy package.json dist\\",
        "start": "rollup -w -c",
        "preview": "npm run build && node dev/preview/serve.mjs",
        "check": "tsc --noEmit -p tsconfig.check.json",
        "test": "node --test tests/*.test.ts",
        "publish:local": "bash scripts/publish.sh"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/drdrdrdr69/spearo-windy-plugin"
    },
    "keywords": [
        "windy",
        "windy.com",
        "plugins",
        "spearfishing",
        "freediving",
        "spearo"
    ],
    "author": "spearo.app",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/drdrdrdr69/spearo-windy-plugin/issues"
    },
    "homepage": "https://spearo.app",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3"
    }
}
